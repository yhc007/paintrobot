# Paintrobot API configuration
# Copy to .env.local and fill in values. .env.local is gitignored.

# API gateway listen address
ADDR=0.0.0.0:18080

# Edge client auth (comma-separated list of accepted keys)
EDGE_API_KEYS=

# CoreDB HTTP endpoint
COREDB_URL=http://127.0.0.1:9043
COREDB_KEYSPACE=paintrobot

# OpenWeatherMap
# Get a key at https://openweathermap.org/api
OWM_API_KEY=
